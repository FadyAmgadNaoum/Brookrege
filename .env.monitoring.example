# Monitoring settings (infra/monitoring). Copy to .env.monitoring, fill in, then:
#   python3 infra/monitoring/configure.py --topology cluster      (or: single)
# Secrets go in separate files in SECRETS_DIR — see the top of infra/monitoring/configure.py.
PUBLIC_DOMAIN=brookrege.com
ADMIN_DOMAIN=admin.brookrege.com
SECRETS_DIR=/etc/brookrege/monitoring/secrets

# Who gets alert emails (comma-separated list is fine) and how they're sent.
ALERT_EMAIL_TO=fady@example.com
ALERT_EMAIL_FROM=alerts@brookrege.com
# SendGrid's SMTP relay works with the same account used for customer emails (user is literally "apikey").
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey

# Optional chat alerts for critical problems (also needs the secret file):
SLACK_CHANNEL=#brookrege-alerts
TELEGRAM_CHAT_ID=

# Where the monitoring server listens for logs from the other servers (cluster: 10.0.0.1, single: 127.0.0.1)
MON_PRIVATE_IP=10.0.0.1
# Retention (see docs/operations/MONITORING.md)
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=8GB
