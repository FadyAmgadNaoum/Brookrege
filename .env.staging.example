# STAGING server settings (docker-compose.prod.yml + docker-compose.staging.yml). Copy to .env.staging, chmod 600.
# Every secret must be DIFFERENT from production: staging is a test server and more people can reach it.
# Guide: docs/operations/STAGING.md
PUBLIC_DOMAIN=staging.brookrege.com
# One level below the main domain, so Cloudflare's free certificate covers it
ADMIN_DOMAIN=staging-admin.brookrege.com
DB_USER=brookrege
DB_PASSWORD=generate-a-long-random-ALPHANUMERIC-password
DB_NAME=brookrege_staging
JWT_ACCESS_SECRET=generate-with-node-crypto-randomBytes-48-hex
WHATSAPP_NUMBER=201000000000
# Demo data and the demo super admin (staging only). The password must differ from every real one.
STAGING_SEED_DEMO=true
SEED_ADMIN_EMAIL=qa@brookrege.com
SEED_ADMIN_PASSWORD=Choose-A-Different-Strong-Passw0rd!
# ── Phase 2: media on Cloudflare R2 (recommended in production) ──
STORAGE_DRIVER=r2
PUBLIC_MEDIA_BASE_URL=https://media-staging.brookrege.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=brookrege-media-staging
# 64 hex chars — encrypts email/SMS provider keys. Keep a copy: losing it means re-entering the keys.
SETTINGS_ENCRYPTION_KEY=
# ── Phase 3: encrypted backups ──
# Public key only (age1…). Create the pair on YOUR computer: age-keygen -o brookrege-backup-key.txt
# Keep brookrege-backup-key.txt offline (password manager + printed copy). Without it, backups can't be restored.
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-key
# Optional off-site copies to R2 (use a separate bucket and a token that can only write to it):
BACKUP_REMOTE=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# ── Phase 3: security (defaults shown; change only with a reason) ──
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# TLS towards Cloudflare: TLS 1.3 only once Cloudflare proxies the site (docs/security/INFRASTRUCTURE.md)
TLS_PROTOCOLS=TLSv1.2 TLSv1.3
# on = accept only Cloudflare's client certificate (Authenticated Origin Pulls). Turn on at Cloudflare FIRST.
ORIGIN_PULL=off
# ── Phase 4: performance & monitoring ──
# Redis (shared cache). 24+ random letters/digits: openssl rand -hex 24
REDIS_PASSWORD=generate-a-long-random-alphanumeric-password
REDIS_MAXMEMORY=256mb
# Release images built by GitHub Actions (.github/workflows/release.yml). Replace OWNER with the GitHub
# account/organisation (lower case). IMAGE_TAG (the release now running) is written by scripts/deploy/deploy.sh —
# don't edit it by hand; use deploy.sh / rollback.sh (docs/operations/DEPLOYMENT-RUNBOOK.md).
IMAGE_REGISTRY=ghcr.io/OWNER/brookrege
# The web image built for the staging address (release.yml builds both)
WEB_VARIANT=-staging
# Build identifier for local builds only (release images carry their commit)
APP_VERSION=dev
# Slow-query log threshold (ms) and database memory
PG_SLOW_QUERY_MS=500
