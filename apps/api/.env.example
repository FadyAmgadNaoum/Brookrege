NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://brookrege:brookrege@localhost:5432/brookrege?schema=public
# Used only by `prisma migrate`. Locally the same as DATABASE_URL; in production pgBouncer's session-mode alias.
DIRECT_DATABASE_URL=postgresql://brookrege:brookrege@localhost:5432/brookrege?schema=public
# Optional read replica (Phase 2). Leave empty for a single database.
DATABASE_REPLICA_URL=
INSTANCE_ID=local
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_API_URL=http://localhost:4000
UPLOAD_DIR=./uploads
EXPIRY_CRON=0 2 * * *
TZ_NAME=Africa/Cairo
SEED_ADMIN_EMAIL=admin@brookrege.com
SEED_ADMIN_PASSWORD=ChangeMe!2026-strong

# ── Phase 2 ──
# Media storage: "local" (folder, dev/single server) or "r2" (Cloudflare R2 + CDN)
STORAGE_DRIVER=local
# R2 only: bucket connected to a custom domain on Cloudflare, e.g. https://media.brookrege.com
PUBLIC_MEDIA_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Background jobs inside this process (set false where a dedicated worker runs)
JOBS_WORKER=true
JOBS_CONCURRENCY=4
# Encrypts SendGrid/Twilio keys saved from the admin: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=
# Used in email links
ADMIN_APP_URL=http://localhost:3001

# ── Phase 3: security ──
# "production" turns on strict start-up checks (refuses example secrets, non-HTTPS URLs, insecure cookies).
APP_ENV=development
# Admin sessions: signed out after this many idle minutes, and after this many hours in any case
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# bcrypt cost for staff passwords (existing hashes are upgraded at next sign-in)
BCRYPT_ROUNDS=12
# Sign-in attempts per network address per 15 minutes (per app server); account lockout is separate
SIGNIN_RATE_LIMIT=10
# Only during an encryption-key rotation (docs/security/KEY-ROTATION.md)
SETTINGS_ENCRYPTION_KEY_PREVIOUS=
# EMERGENCY ONLY — ignore the admin IP allowlist (docs/security/ACCOUNT-SECURITY.md)
ADMIN_IP_ALLOWLIST_BYPASS=false
