        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_eventloop_lag_p99_seconds{job=~\"api|worker\", server=~\"$server\"}",
          "datasource": {
            "type": "prometheus",
