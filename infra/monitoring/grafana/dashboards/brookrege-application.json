        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\"api|worker\", server=~\"$server\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{job}} {{server}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
